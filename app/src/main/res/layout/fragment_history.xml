<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header + Quick Log + Export -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PERFORMANCE LEDGER"
                android:textColor="#F5B041"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnLogManualTrade"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#F5B041"
                android:text="+ Log Trade"
                android:textAllCaps="false"
                android:textColor="#0B0E14"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnExportCsv"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="#1E2433"
                android:text="CSV"
                android:textAllCaps="false"
                android:textColor="#E5E7EB"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 3 Isolated Ledger Switcher -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="#131722"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/tabLedgerManual"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="My MT5 Journal"
                android:textColor="#0B0E14"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabLedgerScan"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="AI Chart Scans"
                android:textColor="#9CA3AF"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabLedgerBot"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Auto Hunter"
                android:textColor="#9CA3AF"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Institutional Monthly KPI Summary Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#131722"
            android:orientation="horizontal"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WIN RATE"
                    android:textColor="#8A94A6"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/tvKpiWinRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="0.0%"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NET USD / PIPS"
                    android:textColor="#8A94A6"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/tvKpiNetPnl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="$0.00"
                    android:textColor="#10B981"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NET R-MULT"
                    android:textColor="#8A94A6"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/tvKpiNetR"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="0.0R"
                    android:textColor="#F5B041"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TP / SL"
                    android:textColor="#8A94A6"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/tvKpiRecord"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="0W - 0L"
                    android:textColor="#D1D5DB"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Goals & Risk Guardrails Card -->
        <LinearLayout
            android:id="@+id/goalsCardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#131722"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TARGETS &amp; RISK GUARDRAILS (USD)"
                    android:textColor="#F5B041"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnEditGoals"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#1E2433"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Edit Goals"
                    android:textColor="#E5E7EB"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDailyTargetStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Today Target: $0.00 / $50.00"
                android:textColor="#D1D5DB"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/pbDailyTarget"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="#1E2433"
                android:progressTint="#10B981" />

            <TextView
                android:id="@+id/tvMonthlyTargetStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Monthly Target: $0.00 / $1,000.00"
                android:textColor="#D1D5DB"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/pbMonthlyTarget"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="#1E2433"
                android:progressTint="#F5B041" />

            <TextView
                android:id="@+id/tvGuardrailWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Daily Risk: $0.00 / -$30.00 max loss • 0 / 3 trades today"
                android:textColor="#9CA3AF"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- Multi-Scale P&L Calendar Header (Day / Month / Year) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#0F131C"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingTop="8dp">

            <Button
                android:id="@+id/btnPrevMonth"
                android:layout_width="38dp"
                android:layout_height="34dp"
                android:backgroundTint="#1E2433"
                android:padding="0dp"
                android:text="◀"
                android:textColor="#F5B041"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvCalendarMonthTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="November 2026"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnNextMonth"
                android:layout_width="38dp"
                android:layout_height="34dp"
                android:backgroundTint="#1E2433"
                android:padding="0dp"
                android:text="▶"
                android:textColor="#F5B041"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Day / Month / Year Scale Toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:background="#0F131C"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp"
            android:paddingTop="4dp">

            <TextView
                android:id="@+id/btnScaleDay"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#F5B041"
                android:gravity="center"
                android:text="DAY"
                android:textColor="#0B0E14"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnScaleMonth"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="MONTH"
                android:textColor="#9CA3AF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnScaleYear"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="YEAR"
                android:textColor="#9CA3AF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Heatmap P&L Calendar View -->
        <com.apexquant.pipsniper.ui.PnlCalendarView
            android:id="@+id/pnlCalendarView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0F131C"
            android:padding="8dp" />

        <!-- Equity Curve & Session Analytics Graphs -->
        <com.apexquant.pipsniper.ui.PerformanceChartsView
            android:id="@+id/performanceChartsView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#0F131C"
            android:padding="8dp" />

        <!-- Active Filter Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTradeListHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="NOVEMBER 2026 TRADES"
                android:textColor="#8A94A6"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvClearDayFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Show Full Month"
                android:textColor="#F5B041"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Trade Cards Container -->
        <LinearLayout
            android:id="@+id/tradeCardsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
